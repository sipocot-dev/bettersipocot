# Local Government Website Configuration
# Copy this file to .env.local and update with your government's information

# Government Information
VITE_GOVERNMENT_NAME="Sipocot"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Region V"
VITE_PROVINCE="Camarines Sur"

# Website Information
VITE_WEBSITE_URL="https://bettersipocot.org"
VITE_CONTACT_EMAIL="info@bettersipocot.org"
VITE_CONTACT_PHONE="+639491216781"

# Social Media (Optional)
VITE_FACEBOOK_URL="https://facebook.com/your-government"
VITE_TWITTER_URL="https://twitter.com/your-government"
VITE_INSTAGRAM_URL="https://instagram.com/your-government"
VITE_YOUTUBE_URL="https://youtube.com/your-government"

# SEO
VITE_SITE_DESCRIPTION="A community-run portal for the Municipality of Sipocot, Camarines Sur"
VITE_SITE_KEYWORDS="Sipocot, Camarines Sur, Bicol, government, local government, services"
VITE_OG_IMAGE_URL="https://bettersipocot.org/og-image.jpg"
VITE_TWITTER_HANDLE="@your-government"

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""
